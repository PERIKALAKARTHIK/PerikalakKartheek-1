{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Vite dev server",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev",
                "--",
                "--host",
                "127.0.0.1",
                "--port",
                "8080",
                "--strictPort"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*http://127\\.0\\.0\\.1:8080/.*"
                }
            }
        }
    ]
}
